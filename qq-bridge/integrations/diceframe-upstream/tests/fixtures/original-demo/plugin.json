{
  "schema_version": 1,
  "id": "dsh-diceframe-demo",
  "name": "星火镇·演示",
  "version": "0.1.0",
  "description": "dsh-diceframe 的原创演示内容包：一座山顶小镇与一位旅人。非任何作品改编，仅用于测试 DiceFrame 格式互通。",
  "plugin_type": "content-pack",
  "config_schema": "config.schema.json",
  "capabilities": ["content.world", "content.character-template"],
  "permissions": ["content.read", "content.import"],
  "contributes": {
    "world_templates": ["content/worlds/*.json"],
    "character_templates": ["content/characters/*.json"],
    "items": ["content/items/*.json"]
  }
}
